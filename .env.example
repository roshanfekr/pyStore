# --- Django ---
SECRET_KEY=insecure-dev-only-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
ACTIVE_THEME=pacific

# --- Database (SQL Server) ---
DATABASE_URL=mssql://sa:123456@localhost:1433/pystore?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

# --- Redis / Cache ---
REDIS_URL=redis://localhost:6379/0
# Development uses an in-process cache and eager Celery by default so it runs
# without Redis. Set DEV_USE_REDIS=True to use the real Redis cache/broker.
DEV_USE_REDIS=False

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Search ---
SEARCH_BACKEND=database

# --- Storefront (hybrid SSR + Vue) ---
# Content pages are always server-rendered. When enabled, the interactive routes
# (cart, checkout, login, account, wishlist, compare, orders) are served by the
# built Vue SPA (run `npm run build` in src/frontend first).
STOREFRONT_SPA_ENABLED=True

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@pystore.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Security ---
CORS_ALLOWED_ORIGINS=

# --- Settings encryption (optional) ---
SETTINGS_ENCRYPTION_KEY=
