# --- Django ---
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
ACTIVE_THEME=default
# Theme plugins: src/plugins/theme_<slug> (e.g. ACTIVE_THEME=pacific for plugins/theme_pacific)

# --- Database (SQL Server) ---
# Requires Microsoft ODBC Driver 17 for SQL Server
DATABASE_URL=mssql://pystore:pystore@localhost:1433/pystore?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

# --- Redis / Cache ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Search ---
SEARCH_BACKEND=database

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@pystore.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Security ---
CORS_ALLOWED_ORIGINS=

# --- Settings encryption (optional) ---
SETTINGS_ENCRYPTION_KEY=
